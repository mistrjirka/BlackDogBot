# AI Provider Configuration
# Use "openrouter" or "openai-compatible"
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=your-key-here
OPENAI_COMPATIBLE_MODEL=llama3

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Logging
LOG_LEVEL=info

# Agent step limits
# Maximum number of LLM->tool->LLM cycles for the main chat agent (default: 300)
BLACKDOGBOT_MAIN_AGENT_MAX_STEPS=300

# Maximum number of LLM->tool->LLM cycles for the cron/scheduler agent (default: 300)
BLACKDOGBOT_CRON_AGENT_MAX_STEPS=300

# Tool output limits
# Tool results above this many characters become stored variables (default: 4000)
BLACKDOGBOT_CAPTURE_THRESHOLD_CHARS=4000
# Maximum characters shown in a stored-result stub preview (default: 1200)
BLACKDOGBOT_PREVIEW_MAX_CHARS=1200
# Maximum characters returned by inspect_variable per call (default: 24000)
BLACKDOGBOT_INSPECT_VARIABLE_MAX_CHARS=24000
# Default inspect_variable slice size (default: 4000)
BLACKDOGBOT_INSPECT_VARIABLE_DEFAULT_CHARS=4000
# Default row limit for read_from_database (default: 20, max 50)
BLACKDOGBOT_READ_DB_DEFAULT_LIMIT=20
