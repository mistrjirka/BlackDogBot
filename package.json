{
  "name": "blackdogbot",
  "version": "0.2.0",
  "description": "Proactive AI assistant with skills and scheduled tasks",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "scripts/launch.sh",
    "start:direct": "tsx src/index.ts",
    "ask:local": "node brain-interface/scripts/ask-agent.mjs",
    "dev": "scripts/launch.sh --watch",
    "dev:direct": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:core": "vitest run tests/integration/core",
    "test:fast": "vitest run tests/unit tests/integration/core",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && mkdir -p dist/workers && cp src/workers/run-code-worker.cjs dist/workers/",
    "test:build": "tsc && vitest run --config vitest.integration.config.ts",
    "migrate:plan": "tsx src/migrations/cli.ts plan",
    "migrate:apply": "tsx src/migrations/cli.ts apply",
    "migrate:rollback": "tsx src/migrations/cli.ts rollback",
    "migrate:recover": "tsx src/migrations/cli.ts recover",
    "test:migrations": "vitest run tests/unit/migrations",
    "backup:create": "tsx src/migrations/cli.ts backup-create",
    "backup:verify": "tsx src/migrations/cli.ts backup-verify",
    "backup:restore": "tsx src/migrations/cli.ts backup-restore",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py'",
    "upgrade:bot": "python3 scripts/upgrade.py",
    "backup:prune": "tsx src/migrations/backup-retention-cli.ts",
    "paths:plan": "tsx src/migrations/cli.ts paths-plan",
    "paths:apply": "tsx src/migrations/cli.ts paths-apply",
    "paths:recover": "tsx src/migrations/cli.ts paths-recover",
    "paths:rollback": "tsx src/migrations/cli.ts paths-rollback"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "GPL-2.0",
  "dependencies": {
    "@adriangalilea/tghtml": "jsr:^0.2.3",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/provider": "^4.0.7",
    "@huggingface/transformers": "^3.4.0",
    "@lancedb/lancedb": "^0.17.0",
    "@lmstudio/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openrouter/ai-sdk-provider": "^2.2.3",
    "@types/turndown": "^5.0.6",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "ai": "^7.0.66",
    "better-sqlite3": "^12.11.1",
    "bottleneck": "^2.19.0",
    "discord.js": "^14.14.0",
    "dotenv": "^17.3.1",
    "eslint-scope": "^9.1.2",
    "fuse.js": "^7.3.0",
    "grammy": "^1.48.0",
    "gray-matter": "^4.0.0",
    "js-tiktoken": "^1.0.21",
    "marked": "^17.0.3",
    "nanoid": "^5.1.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.0",
    "turndown": "^7.2.2",
    "undici": "^7.29.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/eslint-scope": "^9.1.0",
    "@types/node": "^22.0.0",
    "@types/socket.io": "^3.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@11.28.3"
}
